# Database connection string (PostgreSQL with PostGIS extension on host port 5433)
DATABASE_URL="postgresql://vansetu_user:vansetu_secret@localhost:5433/vansetu_db?schema=public"

# Server Port & Node Environment
PORT=5000
NODE_ENV=development

# JWT Authentication Secrets
JWT_SECRET="vansetu_super_secret_jwt_access_key_2026_sih"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="vansetu_super_secret_jwt_refresh_key_2026_sih"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS configuration
CORS_ORIGIN="http://localhost:5173"

# Evidence Upload Signed URL Secret
EVIDENCE_URL_SECRET="vansetu_evidence_download_signed_secret_2026_sih"
